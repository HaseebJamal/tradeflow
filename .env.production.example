APP_NAME="Profit Point"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Keep production diagnostics in logs. Never expose stack traces to visitors.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Configure the production database and mail provider in the deployment secret
# store. Do not copy local development credentials into this file.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
