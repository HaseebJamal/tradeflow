<IfModule mod_rewrite.c>
    RewriteEngine On

    # This project may be served one level above Laravel's public web root.
    # Map the public asset directories without relying on a local XAMPP path.
    # The remaining requests are handled by the root front controller below.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^(build|css|images|js|storage)/(.*)$ public/$1/$2 [L,NC]

    # Keep /public out of the URL while preserving the correct base path for
    # routes such as /register-business.
    RewriteRule ^ index.php [L]
</IfModule>
